{
  "name": "codex-cursor-bridge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm smoke:mcp",
    "bootstrap": "tsx src/cli.ts bootstrap",
    "uninstall": "tsx src/cli.ts uninstall",
    "repo:add": "tsx src/cli.ts repo:add",
    "task:approve": "tsx src/cli.ts task:approve",
    "package-manager:provision": "tsx src/cli.ts package-manager:provision",
    "models:list": "tsx src/cli.ts models:list",
    "stats": "tsx src/cli.ts stats",
    "smoke:mcp": "node dist/smoke-mcp.js",
    "smoke:cursor": "node dist/smoke-cursor-live.js",
    "mcp": "node dist/mcp.js",
    "supervisor": "node dist/supervisor.js"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.23",
    "@modelcontextprotocol/sdk": "1.29.0",
    "minimatch": "10.2.4",
    "yaml": "2.8.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vitest": "4.1.10"
  }
}
